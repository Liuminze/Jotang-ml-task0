# ===== 0. 环境 + 随机种子 =====
import numpy as np, torch, torch.nn as nn, matplotlib.pyplot as plt
from sklearn.datasets import load_digits
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import confusion_matrix
from torch.utils.data import DataLoader, TensorDataset

SEED = 42
np.random.seed(SEED)        # numpy 随机数发生器
torch.manual_seed(SEED)     # torch 随机数发生器（管权重初始化、洗牌）

# ===== 1. 原始数据 =====
digits = load_digits()                       # load(加载) + digits(数字)
X = digits.data.astype(np.float32)           # (1797, 64)  64 = 8x8 图拉平
y = digits.target.astype(np.int64)           # (1797,)

# ===== 2. 三分数据 60/20/20 =====
X_trainval, X_test, y_trainval, y_test = train_test_split(
    X, y, test_size=0.2, random_state=SEED, stratify=y)
X_train, X_val, y_train, y_val = train_test_split(
    X_trainval, y_trainval, test_size=0.25, random_state=SEED, stratify=y_trainval)
# stratify = 分层，保证三份里 0-9 比例一致 → 1077 / 360 / 360

# ===== 3. 标准化（⚠️ fit 只能碰训练集）=====
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train).astype(np.float32)   # fit 学均值方差 + transform 套用
X_val   = scaler.transform(X_val).astype(np.float32)         # 只套用
X_test  = scaler.transform(X_test).astype(np.float32)

# ===== 4. Tensor + 分批 =====
def make_loader(Xp, yp, shuffle):
    return DataLoader(TensorDataset(torch.tensor(Xp, dtype=torch.float32),
                                    torch.tensor(yp, dtype=torch.int64)),
                      batch_size=32, shuffle=shuffle)
train_loader = make_loader(X_train, y_train, True)    # shuffle=洗牌，只给训练集开
val_loader   = make_loader(X_val,   y_val,   False)
test_loader  = make_loader(X_test,  y_test,  False)

# ===== 5. 模型 64 -> 64 -> 10 =====
class MLP(nn.Module):
    def __init__(self):
        super().__init__()                  # super = 父类，必须先初始化
        self.fc1  = nn.Linear(64, 64)       # fc = fully connected 全连接
        self.relu = nn.ReLU()               # 非线性，缺了它多层等于一层
        self.fc2  = nn.Linear(64, 10)       # ⚠️ 别加 Softmax，损失函数里自带

    def forward(self, x):
        return self.fc2(self.relu(self.fc1(x)))

model = MLP()
print('参数量 =', sum(p.numel() for p in model.parameters()))   # 4810

# ===== 6. 损失 + 优化器 =====
criterion = nn.CrossEntropyLoss()                            # criterion = 评判标准
optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)    # lr = learning rate 学习率

# ===== 7. 跑一轮（传 optimizer=训练，不传=评估）=====
def run_one_epoch(loader, model, criterion, optimizer=None):
    is_training = optimizer is not None
    model.train() if is_training else model.eval()
    total_loss, correct, total = 0.0, 0, 0
    for bx, by in loader:
        with torch.set_grad_enabled(is_training):     # 评估时不记计算图
            out = model(bx)                           # 前向：只算一次
            loss = criterion(out, by)
            if is_training:
                optimizer.zero_grad()                 # 1 清零（默认累加，不清会跑飞）
                loss.backward()                       # 2 反向算梯度
                optimizer.step()                      # 3 更新参数
        pred = out.argmax(dim=1)                      # argmax = 最大值的下标
        total_loss += loss.item() * bx.size(0)
        correct    += (pred == by).sum().item()
        total      += by.size(0)
    return total_loss / total, correct / total

# ===== 8. 训练 60 轮 =====
best_val_acc, best_state = 0.0, None
history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': []}
for epoch in range(1, 61):
    tr_loss, tr_acc = run_one_epoch(train_loader, model, criterion, optimizer)
    va_loss, va_acc = run_one_epoch(val_loader,   model, criterion)
    history['train_loss'].append(tr_loss); history['val_loss'].append(va_loss)
    history['train_acc'].append(tr_acc);   history['val_acc'].append(va_acc)
    if va_acc > best_val_acc:              # 只存验证集最高的那一份
        best_val_acc = va_acc
        best_state = {k: v.clone() for k, v in model.state_dict().items()}   # clone 复制，否则跟着变
    if epoch % 10 == 0:
        print(f'epoch {epoch:3d} | train {tr_loss:.4f}/{tr_acc:.3f} | val {va_loss:.4f}/{va_acc:.3f}')

# ===== 9. 曲线 =====
fig, ax = plt.subplots(1, 2, figsize=(11, 4))
ax[0].plot(history['train_loss'], label='train'); ax[0].plot(history['val_loss'], label='val')
ax[1].plot(history['train_acc'], label='train'); ax[1].plot(history['val_acc'], label='val')
ax[0].set_title('Loss'); ax[1].set_title('Acc'); ax[0].legend(); ax[1].legend(); plt.show()

# ===== 10. 测试（解封）=====
model.load_state_dict(best_state); model.eval()
test_loss, test_acc = run_one_epoch(test_loader, model, criterion)
print(f'测试准确率 = {test_acc:.3f}')      # 0.969

# ===== 11. 混淆矩阵 =====
all_pred, all_true = [], []
with torch.no_grad():
    for bx, by in test_loader:
        all_pred.append(model(bx).argmax(dim=1)); all_true.append(by)
cm = confusion_matrix(torch.cat(all_true).numpy(), torch.cat(all_pred).numpy())
plt.imshow(cm, cmap='Blues'); plt.colorbar(); plt.title('混淆矩阵'); plt.show()

# ===== 12. 保存 + 加载 =====
torch.save(model.state_dict(), 'mlp_digits.pth')            # 只存参数字典
loaded = MLP()
loaded.load_state_dict(torch.load('mlp_digits.pth', weights_only=True))   # weights_only=不执行代码
loaded.eval()
_, acc2 = run_one_epoch(test_loader, loaded, criterion)
print('加载后准确率 =', round(acc2, 3), '| 一致：', abs(acc2 - test_acc) < 1e-9)

